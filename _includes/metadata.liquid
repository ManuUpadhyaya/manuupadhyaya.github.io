{% assign has_google_verification = false %}
{% assign has_bing_verification = false %}
{% if site.enable_google_verification and site.google_site_verification != blank %}
  {% assign has_google_verification = true %}
{% endif %}
{% if site.enable_bing_verification and site.bing_site_verification != blank %}
  {% assign has_bing_verification = true %}
{% endif %}

{% if has_google_verification or has_bing_verification %}
  <!-- Website verification -->
  {% if has_google_verification %}
    <meta name="google-site-verification" content="{{ site.google_site_verification }}">
  {% endif %}
  {% if has_bing_verification %}
    <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
  {% endif %}
  <!--
    Avoid warning on Google Chrome Error with Permissions-Policy header:
    Origin trial controlled feature not enabled: 'interest-cohort'.
    see https://stackoverflow.com/a/75119417
  -->
  <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
{% endif %}

{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign author_name = author_name | strip %}
{% if site.title == 'blank' %}
  {% assign site_title = author_name %}
{% else %}
  {% assign site_title = site.title %}
{% endif %}
{% if page.url == '/blog/index.html' %}
  {% capture document_title %}{{ page.title }} | {{ site_title }}{% endcapture %}
{% elsif page.title != 'blank' and page.url != '/' %}
  {% if page.title == null or page.title == '' %}
    {% capture document_title %}{{ page.date | date: '%Y' }} | {{ site_title }}{% endcapture %}
  {% else %}
    {% capture document_title %}{{ page.title }} | {{ site_title }}{% endcapture %}
  {% endif %}
{% else %}
  {% assign document_title = site_title %}
{% endif %}
{% assign document_title = document_title | strip | strip_newlines %}
{% assign meta_description = page.seo_description %}
{% if meta_description == nil or meta_description == '' %}
  {% assign meta_description = page.description %}
{% endif %}
{% if meta_description == nil or meta_description == '' %}
  {% assign meta_description = site.description %}
{% endif %}
{% assign meta_description = meta_description | strip | strip_html | strip_newlines %}
{% assign meta_keywords = page.keywords %}
{% if meta_keywords == nil or meta_keywords == '' %}
  {% assign meta_keywords = site.keywords %}
{% endif %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign page_display_title = page.title %}
{% if page_display_title == nil or page_display_title == '' or page_display_title == 'blank' %}
  {% assign page_display_title = site_title %}
{% endif %}
{% assign raw_og_image = page.og_image %}
{% if raw_og_image == nil or raw_og_image == '' %}
  {% assign raw_og_image = site.og_image %}
{% endif %}
{% assign og_image = raw_og_image | absolute_url %}
{% assign og_image_alt = page.og_image_alt %}
{% if og_image_alt == nil or og_image_alt == '' %}
  {% assign og_image_alt = site.og_image_alt %}
{% endif %}
{% if og_image_alt == nil or og_image_alt == '' %}
  {% assign og_image_alt = author_name %}
{% endif %}
{% assign og_locale = site.og_locale | default: site.lang %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ document_title | escape }}</title>
<meta name="author" content="{{ author_name | escape }}">
<meta name="description" content="{{ meta_description | escape }}">
{% if page.url == '/404.html' %}
  <meta name="robots" content="noindex, nofollow">
{% else %}
  <meta name="robots" content="index, follow, max-image-preview:large">
{% endif %}
{% if meta_keywords %}
  <meta name="keywords" content="{{ meta_keywords | escape }}">
{% endif %}

{% assign is_blog_post = false %}
{% if page.url != '/blog/index.html' and page.url contains '/blog/' %}
  {% unless page.url contains '/tag/' or page.url contains '/category/' %}
    {% assign is_blog_post = true %}
  {% endunless %}
{% endif %}

{% if site.serve_og_meta %}
  <!-- OpenGraph -->
  <meta property="og:site_name" content="{{ site_title | escape }}">
  <meta property="og:type" content="{% if is_blog_post %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ document_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  {% if og_image %}
    <meta property="og:image" content="{{ og_image }}">
    <meta property="og:image:alt" content="{{ og_image_alt | escape }}">
  {% endif %}
  <meta property="og:locale" content="{{ og_locale | replace: '-', '_' }}">

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ document_title | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  {% if og_image %}
    <meta name="twitter:image" content="{{ og_image }}">
    <meta name="twitter:image:alt" content="{{ og_image_alt | escape }}">
  {% endif %}
  {% if site.x_username %}
    <meta name="twitter:site" content="@{{ site.x_username }}">
    <meta name="twitter:creator" content="@{{ site.x_username }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  <!-- Schema.org -->
  {% assign socials = site.data.socials %}
  {% assign sameaslinks = '' | split: ',' %}
  {% if socials.orcid_id %}
    {% capture link %}https://orcid.org/{{ socials.orcid_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.scholar_userid %}
    {% capture link %}https://scholar.google.com/citations?user={{ socials.scholar_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.semanticscholar_id %}
    {% capture link %}https://www.semanticscholar.org/author/{{ socials.semanticscholar_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.publons_id %}
    {% capture link %}https://publons.com/a/{{ socials.publons_id }}/{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.lattes_id %}
    {% capture link %}https://lattes.cnpq.br/{{ socials.lattes_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.osf_id %}
    {% capture link %}https://osf.io/{{ socials.osf_id }}/{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.research_gate_profile %}
    {% capture link %}https://www.researchgate.net/profile/{{ socials.research_gate_profile }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.scopus_id %}
    {% capture link %}https://www.scopus.com/authid/detail.uri?authorId={{ socials.scopus_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.github_username %}
    {% capture link %}https://github.com/{{ socials.github_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.telegram_username %}
    {% capture link %}https://telegram.me/{{ socials.telegram_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.linkedin_username %}
    {% capture link %}https://www.linkedin.com/in/{{ socials.linkedin_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.x_username %}
    {% capture link %}https://twitter.com/{{ socials.x_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.mastodon_username %}
    {% capture link %}https://{{ socials.mastodon_username  }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.medium_username %}
    {% capture link %}https://medium.com/@{{ socials.medium_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.quora_username %}
    {% capture link %}https://www.quora.com/profile/{{ socials.quora_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.blogger_url %}
    {% capture link %}{{ socials.blogger_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.work_url %}
    {% capture link %}{{ socials.work_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.wikidata_id %}
    {% capture link %}https://www.wikidata.org/wiki/{{ socials.wikidata_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.wikipedia_id %}
    {% capture link %}https://wikipedia.org/wiki/User:{{ socials.wikipedia_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.strava_userid %}
    {% capture link %}https://www.strava.com/athletes/{{ socials.strava_userid }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.keybase_username %}
    {% capture link %}https://keybase.io/{{ socials.keybase_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.gitlab_username %}
    {% capture link %}https://gitlab.com/{{ socials.gitlab_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.dblp_url %}
    {% capture link %}{{ socials.dblp_url }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.stackoverflow_id %}
    {% capture link %}https://stackoverflow.com/users/{{ socials.stackoverflow_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.kaggle_id %}
    {% capture link %}https://www.kaggle.com/{{ socials.kaggle_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.lastfm_id %}
    {% capture link %}https://www.last.fm/user/{{ socials.lastfm_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.spotify_id %}
    {% capture link %}https://open.spotify.com/user/{{ socials.spotify_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.pinterest_id %}
    {% capture link %}https://www.pinterest.com/{{ socials.pinterest_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.unsplash_id %}
    {% capture link %}https://unsplash.com/@{{ socials.unsplash_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.instagram_id %}
    {% capture link %}https://instagram.com/{{ socials.instagram_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.facebook_id %}
    {% capture link %}https://facebook.com/{{ socials.facebook_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.youtube_id %}
    {% capture link %}https://youtube.com/@{{ socials.youtube_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.discord_id %}
    {% capture link %}https://discord.com/users/{{ socials.discord_id }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% if socials.zotero_username %}
    {% capture link %}https://www.zotero.org/{{ socials.zotero_username }}{% endcapture %}
    {% assign sameaslinks = sameaslinks | push: link %}
  {% endif %}
  {% assign home_url = '/' | absolute_url %}
  {% assign person_id = home_url | append: '#person' %}
  {% assign website_id = home_url | append: '#website' %}
  {% assign webpage_id = canonical_url | append: '#webpage' %}
  {% assign page_schema_type = 'WebPage' %}
  {% if is_blog_post %}
    {% assign page_schema_type = 'BlogPosting' %}
  {% elsif page.collection == 'news' %}
    {% assign page_schema_type = 'NewsArticle' %}
  {% endif %}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": {{ person_id | jsonify }},
          "name": {{ author_name | jsonify }},
          "url": {{ home_url | jsonify }},
          "image": {{ og_image | jsonify }},
          "jobTitle": "Postdoctoral researcher",
          "affiliation": [
            {
              "@type": "Organization",
              "name": "Inria Paris",
              "url": "https://www.inria.fr/fr/centre-inria-de-paris"
            },
            {
              "@type": "Organization",
              "name": "Center of Applied Mathematics, École Polytechnique",
              "url": "https://cmap.ip-paris.fr/en/"
            }
          ],
          "knowsAbout": [
            "Optimization",
            "First-order methods",
            "Mathematical programming",
            "Machine learning",
            "Lyapunov analysis"
          ],
          "sameAs": [
            {% for link in sameaslinks %}
              {{ link | strip | jsonify }}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        },
        {
          "@type": "WebSite",
          "@id": {{ website_id | jsonify }},
          "url": {{ home_url | jsonify }},
          "name": {{ site_title | jsonify }},
          "description": {{ site.description | jsonify }},
          "publisher": {
            "@id": {{ person_id | jsonify }}
          },
          "inLanguage": {{ site.lang | jsonify }}
        },
        {
          "@type": {{ page_schema_type | jsonify }},
          "@id": {{ webpage_id | jsonify }},
          "url": {{ canonical_url | jsonify }},
          "name": {{ document_title | jsonify }},
          "headline": {{ page_display_title | jsonify }},
          "description": {{ meta_description | jsonify }},
          "image": {{ og_image | jsonify }},
          "isPartOf": {
            "@id": {{ website_id | jsonify }}
          },
          "author": {
            "@id": {{ person_id | jsonify }}
          },
          "inLanguage": {{ site.lang | jsonify }}
          {% if page.date %},
          "datePublished": {{ page.date | date_to_xmlschema | jsonify }},
          "dateModified": {{ page.last_modified_at | default: page.date | date_to_xmlschema | jsonify }}
          {% endif %}
        }
      ]
    }
  </script>
{% endif %}
