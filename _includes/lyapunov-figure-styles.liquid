{% unless lyapunov_figure_styles_included %}
  {% assign lyapunov_figure_styles_included = true %}
  <style>
    .lyapunov-contraction-figure {
      --lc-ink: #222;
      --lc-muted: #777;
      --lc-label: #747474;
      max-width: 760px;
      margin: 1.75rem auto;
    }
    html[data-theme='dark'] .lyapunov-contraction-figure {
      --lc-ink: #eee;
      --lc-muted: #aaa;
      --lc-label: #aaa;
    }
    .lyapunov-contraction-figure .lc-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 150px;
      align-items: center;
      gap: 1.5rem;
    }
    .lyapunov-contraction-figure .lc-plot {
      position: relative;
      min-width: 0;
    }
    .lyapunov-contraction-figure .lc-canvas {
      position: relative;
    }
    .lyapunov-contraction-figure svg {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
      color: var(--lc-ink);
      font-family: inherit;
      font-size: 1em;
      font-style: normal;
      font-weight: inherit;
    }
    .lyapunov-contraction-figure svg[hidden] {
      display: none;
    }
    .lyapunov-contraction-figure .lc-axis,
    .lyapunov-contraction-figure .lc-tick {
      fill: none;
      stroke: var(--lc-muted);
      stroke-width: 0.6;
      vector-effect: non-scaling-stroke;
    }
    .lyapunov-contraction-figure .lc-arrow {
      fill: var(--lc-muted);
    }
    .lyapunov-contraction-figure .lc-axis-text {
      fill: var(--lc-muted);
      font-variant-numeric: tabular-nums;
    }
    .lyapunov-contraction-figure .lc-reference {
      fill: none;
      stroke: var(--lc-muted);
      stroke-width: 0.7;
      stroke-dasharray: 3 5;
      vector-effect: non-scaling-stroke;
    }
    .lyapunov-contraction-figure .lc-grid {
      fill: none;
      stroke: var(--lc-muted);
      stroke-width: 0.5;
      opacity: 0.12;
      vector-effect: non-scaling-stroke;
    }
    .lyapunov-contraction-figure .lc-axis-label {
      position: absolute;
      visibility: hidden;
      color: var(--lc-muted);
      font-size: 1em;
      line-height: 1;
      white-space: nowrap;
      pointer-events: none;
    }
    .lyapunov-contraction-figure .lc-axis-label {
      color: var(--lc-ink);
    }
    .lyapunov-contraction-figure .lc-curve {
      fill: none;
      stroke-width: 1.2;
      stroke-linejoin: round;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }
    .lyapunov-contraction-figure .lc-distance {
      stroke: var(--lc-ink);
      stroke-dasharray: 7 5;
    }
    .lyapunov-contraction-figure .lc-function {
      stroke: var(--lc-ink);
    }
    .lyapunov-contraction-figure .lc-closed-form {
      stroke: #aaa;
      stroke-width: 5;
    }
    html[data-theme='dark'] .lyapunov-contraction-figure .lc-closed-form {
      stroke: #888;
    }
    .lyapunov-contraction-figure .lc-marker {
      fill: var(--global-bg-color, #fff);
      stroke: var(--lc-ink);
      stroke-width: 1.1;
      vector-effect: non-scaling-stroke;
    }
    .lyapunov-contraction-figure .lc-legend {
      position: absolute;
      visibility: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      margin: 0;
      padding: 0.3rem 0.4rem;
      background: var(--global-bg-color, #fff);
      border: 1px solid var(--global-divider-color, #ddd);
      border-radius: 2px;
      font-size: 1em;
      line-height: 1.1;
      white-space: nowrap;
      pointer-events: none;
    }
    .lyapunov-contraction-figure[data-lc-state='ready'] .lc-legend,
    .lyapunov-contraction-figure[data-lc-state='ready'] .lc-axis-label {
      visibility: visible;
    }
    .lyapunov-contraction-figure .lc-legend-metrics {
      display: flex;
      justify-content: center;
      gap: 1rem;
      width: 100%;
    }
    .lyapunov-contraction-figure .lc-legend-metrics > span,
    .lyapunov-contraction-figure .lc-legend-formula {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .lyapunov-contraction-figure .lc-legend span,
    .lyapunov-contraction-figure .lc-control-heading label span {
      color: var(--lc-ink);
    }
    .lyapunov-contraction-figure .lc-legend .lc-swatch {
      width: 28px;
      height: 8px;
      flex: none;
    }
    .lyapunov-contraction-figure .lc-formula-stacked {
      display: none;
    }
    .lyapunov-contraction-figure .lc-controls {
      display: grid;
      gap: 1.15rem;
      min-width: 0;
      padding: 0;
      border: 0;
      margin: 0;
    }
    .lyapunov-contraction-figure .lc-control-heading {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.2rem;
    }
    .lyapunov-contraction-figure label {
      margin: 0;
    }
    .lyapunov-contraction-figure output {
      color: var(--lc-muted);
      font-size: 0.85em;
      font-variant-numeric: tabular-nums;
    }
    .lyapunov-contraction-figure input[type='range'] {
      appearance: none;
      -webkit-appearance: none;
      display: block;
      width: 100%;
      min-height: 28px;
      margin: 0;
      padding: 0;
      background: transparent;
      cursor: pointer;
    }
    .lyapunov-contraction-figure input[type='range']::-webkit-slider-runnable-track {
      height: 1px;
      background: var(--lc-muted);
    }
    .lyapunov-contraction-figure input[type='range']::-moz-range-track {
      height: 1px;
      background: var(--lc-muted);
    }
    .lyapunov-contraction-figure input[type='range']::-webkit-slider-thumb {
      appearance: none;
      -webkit-appearance: none;
      width: 8px;
      height: 8px;
      margin-top: -3.5px;
      border: 0;
      border-radius: 50%;
      background: var(--lc-ink);
    }
    .lyapunov-contraction-figure input[type='range']::-moz-range-thumb {
      width: 8px;
      height: 8px;
      border: 0;
      border-radius: 50%;
      background: var(--lc-ink);
    }
    .lyapunov-contraction-figure input[type='range']:focus-visible {
      outline: 2px solid var(--lc-ink);
      outline-offset: 3px;
      border-radius: 2px;
    }
    .lyapunov-contraction-figure .lc-status {
      padding: 7rem 1rem;
      margin: 0;
      color: var(--lc-label);
      text-align: center;
      font-size: 0.9em;
    }
    .lyapunov-contraction-figure[data-lyapunov-contraction][data-lc-epsilon-zero='true'] [data-lc-plot],
    .lyapunov-contraction-figure[data-lyapunov-contraction][data-lc-epsilon-zero='true'] .lc-legend,
    .lyapunov-contraction-figure[data-lyapunov-contraction][data-lc-epsilon-zero='true'] .lc-axis-label {
      visibility: hidden;
    }
    .lyapunov-contraction-figure[data-lyapunov-contraction][data-lc-epsilon-zero='true'] .lc-status {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }
    .lyapunov-contraction-figure .caption {
      margin-top: 0.8rem;
      text-align: left;
    }
    .lyapunov-contraction-figure .lc-caption-math {
      font-size: 1rem;
    }
    .lyapunov-contraction-figure .lc-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }
    .lyapunov-contraction-figure [data-lc-print-fallback] {
      display: none;
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) [data-lc-print-fallback] {
      display: block;
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) svg[hidden] {
      display: block !important;
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lc-status {
      display: none;
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lc-axis-label,
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lc-legend,
    .lyapunov-multipliers-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lm-panels[hidden],
    .lyapunov-multipliers-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lm-panels[hidden] .lc-legend,
    .lyapunov-multipliers-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lm-panels[hidden] .lc-axis-label {
      visibility: visible;
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) [data-lc-axis-rho],
    .lyapunov-memory-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) [data-memory-axis-rho] {
      left: 12.4%;
      top: 0;
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) [data-lc-axis-gamma] {
      right: 0;
      top: 91.176%;
      transform: translateY(-50%);
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) [data-lc-axis-limit] {
      left: 94.4%;
      top: 91.176%;
      transform: translate(-50%, 8px);
    }
    .lyapunov-contraction-figure[data-lyapunov-contraction]:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lc-legend {
      left: 10.8%;
      top: 8.824%;
      transform: translate(8px, 8px);
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lc-canvas {
      margin-bottom: 1rem;
    }
    .lyapunov-multipliers-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) .lc-legend {
      left: 16.471%;
      top: 2.963%;
    }
    .lyapunov-multipliers-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) [data-lm-axis-gamma] {
      right: 0;
      top: 89.63%;
      transform: translateY(-50%);
    }
    .lyapunov-multipliers-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) [data-lm-axis-limit] {
      left: 92.353%;
      top: 89.63%;
      transform: translate(-50%, 8px);
    }
    .lyapunov-memory-figure:is(:not([data-lc-state]), [data-lc-state='unavailable']) [data-memory-axis-ratio] {
      right: 0;
      top: 88%;
      transform: translateY(-50%);
    }
    .lyapunov-contraction-figure:is(:not([data-lc-state]), [data-lc-state='unavailable'])
      svg:is([data-lc-plot], [data-lm-plot], [data-memory-plot])
      > :not([data-lc-print-fallback]):not(title):not(desc) {
      display: none;
    }
    @media print {
      .lyapunov-contraction-figure:not([data-lc-state='ready']) [data-lc-print-fallback] {
        display: block;
      }
      .lyapunov-contraction-figure:not([data-lc-state='ready']) svg[hidden] {
        display: block !important;
      }
      .lyapunov-contraction-figure:not([data-lc-state='ready']) .lc-status {
        display: none;
      }
      .lyapunov-contraction-figure:not([data-lc-state='ready']) .lc-axis-label,
      .lyapunov-contraction-figure:not([data-lc-state='ready']) .lc-legend,
      .lyapunov-multipliers-figure:not([data-lc-state='ready']) .lm-panels[hidden],
      .lyapunov-multipliers-figure:not([data-lc-state='ready']) .lm-panels[hidden] .lc-legend,
      .lyapunov-multipliers-figure:not([data-lc-state='ready']) .lm-panels[hidden] .lc-axis-label {
        visibility: visible;
      }
      .lyapunov-contraction-figure:not([data-lc-state='ready']) [data-lc-axis-rho],
      .lyapunov-memory-figure:not([data-lc-state='ready']) [data-memory-axis-rho] {
        left: 12.4%;
        top: 0;
      }
      .lyapunov-contraction-figure:not([data-lc-state='ready']) [data-lc-axis-gamma] {
        right: 0;
        top: 91.176%;
        transform: translateY(-50%);
      }
      .lyapunov-contraction-figure:not([data-lc-state='ready']) [data-lc-axis-limit] {
        left: 94.4%;
        top: 91.176%;
        transform: translate(-50%, 8px);
      }
      .lyapunov-contraction-figure[data-lyapunov-contraction]:not([data-lc-state='ready']) .lc-legend {
        left: 10.8%;
        top: 8.824%;
        transform: translate(8px, 8px);
      }
      .lyapunov-contraction-figure:not([data-lc-state='ready']) .lc-canvas {
        margin-bottom: 1rem;
      }
      .lyapunov-multipliers-figure:not([data-lc-state='ready']) .lc-legend {
        left: 16.471%;
        top: 2.963%;
      }
      .lyapunov-multipliers-figure:not([data-lc-state='ready']) [data-lm-axis-gamma] {
        right: 0;
        top: 89.63%;
        transform: translateY(-50%);
      }
      .lyapunov-multipliers-figure:not([data-lc-state='ready']) [data-lm-axis-limit] {
        left: 92.353%;
        top: 89.63%;
        transform: translate(-50%, 8px);
      }
      .lyapunov-memory-figure:not([data-lc-state='ready']) [data-memory-axis-ratio] {
        right: 0;
        top: 88%;
        transform: translateY(-50%);
      }
    }
    @media (max-width: 620px) {
      .lyapunov-contraction-figure .lc-layout {
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
      }
      .lyapunov-contraction-figure .lc-plot {
        min-height: 0;
      }
      .lyapunov-contraction-figure .lc-formula-wide {
        display: none;
      }
      .lyapunov-contraction-figure .lc-formula-stacked {
        display: inline;
      }
      .lyapunov-contraction-figure[data-lc-legend-below='true'] .lc-legend {
        position: static;
        width: max-content;
        max-width: 100%;
        margin: 0.65rem auto 0;
      }
      .lyapunov-contraction-figure .lc-controls {
        width: min(100%, 330px);
        margin-inline: auto;
        gap: 0.75rem;
      }
      .lyapunov-contraction-figure input[type='range'] {
        min-height: 32px;
      }
    }
  </style>
{% endunless %}
