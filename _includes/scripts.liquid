{% if site.enable_google_analytics and site.google_analytics != blank %}
  <!-- Analytics -->
  <!-- Queue analytics immediately, then load the external gtag library after first interaction or idle. -->
  <script>
    window.dataLayer = window.dataLayer || [];
    window.gtag =
      window.gtag ||
      function () {
        window.dataLayer.push(arguments);
      };
    window.gtag('js', new Date());
    window.gtag('config', '{{ site.google_analytics }}');

    (function () {
      let loaded = false;
      const loadAnalytics = function () {
        if (loaded) return;
        loaded = true;

        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}';
        document.head.appendChild(script);
      };

      ['pointerdown', 'keydown', 'touchstart'].forEach(function (eventName) {
        window.addEventListener(eventName, loadAnalytics, { once: true, passive: true });
      });
      document.addEventListener(
        'visibilitychange',
        function () {
          if (document.visibilityState === 'hidden') loadAnalytics();
        },
        { once: true }
      );
      window.addEventListener(
        'load',
        function () {
          window.setTimeout(loadAnalytics, 10000);
        },
        { once: true }
      );
    })();
  </script>
  <script defer src="{{ '/assets/js/google-analytics-events.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

