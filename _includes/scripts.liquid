<script>
  if (
    document.querySelector(
      ".abstract-toggle, .award-toggle, .bibtex-toggle, .video-toggle, #toc-sidebar, [data-toggle='popover'], .jupyter-notebook-iframe-container iframe"
    )
  ) {
    const needsBootstrap = document.querySelector("#toc-sidebar, [data-toggle='popover']");
    const needsToc = document.querySelector('#toc-sidebar');
    const dependencies = needsBootstrap ? loadBootstrap() : Promise.resolve();

    dependencies
      .then(() => {
        if (needsToc) {
          return loadOptionalScript("{{ '/assets/js/bootstrap-toc.min.js' | relative_url | bust_file_cache }}", { defer: true });
        }
      })
      .then(() => loadOptionalScript("{{ '/assets/js/common.js' | relative_url | bust_file_cache }}", { defer: true }))
      .catch(() => {});
  }
</script>
