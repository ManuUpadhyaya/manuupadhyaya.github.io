<script>
  window.loadOptionalScript =
    window.loadOptionalScript ||
    function (src, options = {}) {
      window.__optionalScripts = window.__optionalScripts || {};
      if (window.__optionalScripts[src]) {
        return window.__optionalScripts[src];
      }

      window.__optionalScripts[src] = new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        if (options.type) {
          script.type = options.type;
        }
        if (options.async) {
          script.async = true;
        }
        if (options.defer) {
          script.defer = true;
        }
        if (options.integrity) {
          script.integrity = options.integrity;
        }
        if (options.crossorigin) {
          script.crossOrigin = options.crossorigin;
        }
        script.onload = resolve;
        script.onerror = reject;
        document.body.appendChild(script);
      });
      return window.__optionalScripts[src];
    };
  window.loadJQuery =
    window.loadJQuery ||
    function () {
      if (window.jQuery) {
        return Promise.resolve(window.jQuery);
      }

      window.__jqueryLoading =
        window.__jqueryLoading ||
        window
          .loadOptionalScript('{{ site.third_party_libraries.jquery.url.js }}', {
            integrity: '{{ site.third_party_libraries.jquery.integrity.js }}',
            crossorigin: 'anonymous',
          })
          .then(() => window.jQuery);

      return window.__jqueryLoading;
    };
  window.loadBootstrap =
    window.loadBootstrap ||
    function () {
      if (window.jQuery && typeof window.jQuery.fn.popover === 'function') {
        return Promise.resolve();
      }

      window.__bootstrapLoading =
        window.__bootstrapLoading || window.loadJQuery().then(() => loadOptionalScript("{{ '/assets/js/bootstrap.bundle.min.js' | relative_url }}"));

      return window.__bootstrapLoading;
    };
</script>
